# Iba zástupné hodnoty. Skutočné hodnoty patria do Vercel -> Project -> Settings -> Environment Variables.
# Všetky premenné sú SERVEROVÉ (používa ich iba api/*), nikdy sa nedostanú do prehliadača.

# Google Calendar (rezervácie) - viď BOOKING-SETUP.md
GOOGLE_SERVICE_ACCOUNT_JSON=
# alternatíva k JSON:
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
CAL_ANETT=
CAL_KARVY=
CAL_VLADIS=
CAL_SHARED=

# voliteľné: potvrdzovacie e-maily cez Resend
RESEND_API_KEY=
MAIL_FROM=
OWNER_EMAIL=

# tajný token pre /api/cron-cancel (rovnaká hodnota aj ako GitHub secret CRON_SECRET)
CRON_SECRET=
